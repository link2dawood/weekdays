{
  "installCommand": "npm install --include=dev",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/week/:week/:year", "destination": "/viikko-:week-:year", "permanent": true },
    { "source": "/month/:month/:year", "destination": "/kuukausi-:month-:year", "permanent": true },
    { "source": "/year/:year", "destination": "/vuosi-:year", "permanent": true },
    { "source": "/print/:year", "destination": "/tulosta-:year", "permanent": true },
    { "source": "/what-is-a-week-number", "destination": "/mika-on-viikkonumero", "permanent": true },
    { "source": "/weeks-in-a-year", "destination": "/kuinka-monta-viikkoa-vuodessa", "permanent": true },
    { "source": "/about-us", "destination": "/tietoa-meista", "permanent": true },
    { "source": "/contact-us", "destination": "/ota-yhteytta", "permanent": true },
    { "source": "/faq", "destination": "/ukk", "permanent": true },
    { "source": "/privacy-policy", "destination": "/tietosuoja", "permanent": true },
    { "source": "/terms-and-conditions", "destination": "/kayttoehdot", "permanent": true },
    { "source": "/sv/vecka-:w(\\d+)-:y(\\d+)", "destination": "/viikko-:w-:y", "permanent": true },
    { "source": "/sv/veckor-:y(\\d+)", "destination": "/vuosi-:y", "permanent": true },
    { "source": "/sv/helgdagar-:y(\\d+)", "destination": "/pyhapaivat-:y", "permanent": true },
    { "source": "/sv", "destination": "/", "permanent": true },
    { "source": "/sv/:path*", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\"; title=\"LLM-readable site summary\", </ukk>; rel=\"help\", </tietosuoja>; rel=\"privacy-policy\", </kayttoehdot>; rel=\"terms-of-service\""
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt|llms-full.txt|og.png|ai.txt)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/widget.js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    }
  ]
}
